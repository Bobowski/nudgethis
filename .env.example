# nudgethis settings. Yard seeds `yard app new --edit-env` from this file.

# Required: the Google sign-in. Redirect URI: <NUDGE_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
NUDGE_ALLOWED_EMAILS=
NUDGE_PUBLIC_URL=https://wrati.dev

# The apps in the frame: name=url, comma separated.
NUDGE_APPS=stario-site=https://stario.dev

# Nudge, the model. Empty means the scripted fake.
OPENAI_API_KEY=

# The coder. Empty CURSOR_API_KEY means the fake coder. GITHUB_TOKEN merges and closes its pull requests.
CURSOR_API_KEY=
GITHUB_TOKEN=
