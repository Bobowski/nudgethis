# nudgethis settings. `yard app new --edit-env` starts from this file; so does `just dev`.
# Empty keys are skipped. The Settings page in nudgethis can set the keys later.

# Required: nudgethis's own address, and the Google sign-in.
# The Google OAuth client's redirect URI is <NUDGE_PUBLIC_URL>/auth/google/callback.
NUDGE_PUBLIC_URL=https://nudge.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Google accounts that may sign in, comma separated.
NUDGE_ALLOWED_EMAILS=

# Yard makes the repos and the apps, and says when a push is live: `yard token new nudgethis`.
YARD_TOKEN=
# Yard's own container on the yard network, the default. On a laptop: https://yard.example.com
# YARD_URL=http://yard-app-1:8000

# Nudge, the model you talk to. Empty means a scripted fake.
OPENAI_API_KEY=

# The coder, a Cursor Cloud Agent that pushes to main. Empty means a fake coder.
CURSOR_API_KEY=
# A model and its params; empty means Cursor's Auto.
# CURSOR_MODEL=grok-4.7:context=256k,reasoning_effort=high,fast=false

# New apps live at <name>.<NUDGE_DOMAIN>. The default is the host of NUDGE_PUBLIC_URL.
# NUDGE_DOMAIN=
# Apps that nudgethis did not make, to open in the frame too: name=url, comma separated.
# NUDGE_APPS=
# Signs the cookie and seals saved keys. Empty: nudgethis makes one and keeps it in /data.
# SESSION_SECRET=
