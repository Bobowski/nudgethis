# nudgethis settings. Yard seeds `yard app new --edit-env` from this file.

# Required: the Google sign-in. Redirect URI: <NUDGE_PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
NUDGE_ALLOWED_EMAILS=
NUDGE_PUBLIC_URL=https://wrati.dev

# The apps in the frame: name=url, comma separated.
NUDGE_APPS=stario-site=https://stario.dev

# Nudge, the model. Empty means the scripted fake.
OPENAI_API_KEY=

# The coder pushes to main. Empty CURSOR_API_KEY means the fake coder.
CURSOR_API_KEY=
# A model and its params; empty means Cursor's Auto.
CURSOR_MODEL=grok-4.7:context=256k,reasoning_effort=high,fast=false

# Yard: nudgethis waits for the deploy of each push before the frame reloads.
# The default is Yard's container on the yard network. On a laptop: https://yard.bobowski.dev
YARD_URL=http://yard-app-1:8000
YARD_TOKEN=

# New apps: <name>.<NUDGE_DOMAIN>, first commit copied from NUDGE_TEMPLATE.
NUDGE_DOMAIN=wrati.dev
NUDGE_TEMPLATE=https://github.com/Bobowski/nudge-template
